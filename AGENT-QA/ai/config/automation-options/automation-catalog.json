{
  "version": "1.1.0",
  "descripcion": "Catalogo de frameworks soportados por el agente test-automation de IA IN QA",
  "default_framework": "playwright-typescript",
  "default_framework_id": "playwright-typescript",
  "frameworks": [
    {
      "id": "playwright-typescript",
      "framework_id": "playwright-typescript",
      "framework_name": "Playwright + TypeScript",
      "framework_type": "web-e2e",
      "nombre": "Playwright + TypeScript",
      "archivo": "automation-options/playwright-typescript.md",
      "rule_file": "ai/config/automation-options/playwright-typescript.md",
      "templates_path": "ai/config/automation-templates/playwright-typescript",
      "output_path": "ai/projects/{project_slug}/artifacts/{story_id}/test-automation/{version}/playwright-typescript",
      "lenguaje": "TypeScript",
      "tipo_app": ["web", "api"],
      "ideal_para": ["e2e", "frontend moderno", "ci/cd", "automatizacion web"],
      "estructura_carpetas": "ai/projects/{project_slug}/artifacts/{story_id}/test-automation/{version}/playwright-typescript/tests/{story_id}.spec.ts",
      "comando_ejecucion": "npx playwright test",
      "dependencias": ["@playwright/test", "typescript"],
      "estructura_por_nivel": {
        "basico": "package.json + playwright.config.ts + tests/{story_id}.spec.ts + README.md",
        "intermedio": "package.json + playwright.config.ts + pages/{module}.page.ts + fixtures/{feature}.fixture.ts + tests/{story_id}.spec.ts + README.md",
        "avanzado": "intermedio + utils/ + test-data/ + evidence/ + metadata.json"
      }
    },
    {
      "id": "playwright-python",
      "framework_id": "playwright-python",
      "framework_name": "Playwright + Python",
      "framework_type": "web-e2e",
      "nombre": "Playwright + Python",
      "archivo": "automation-options/playwright-python.md",
      "rule_file": "ai/config/automation-options/playwright-python.md",
      "templates_path": "",
      "output_path": "ai/projects/{project_slug}/artifacts/{story_id}/test-automation/{version}/playwright-python",
      "lenguaje": "Python",
      "tipo_app": ["web", "api"],
      "ideal_para": ["equipos python", "automatizacion web", "e2e", "api testing"],
      "estructura_carpetas": "ai/projects/{project_slug}/artifacts/{story_id}/test-automation/{version}/playwright-python/tests/{story_id}_test.py",
      "comando_ejecucion": "pytest tests/",
      "dependencias": ["pytest", "playwright", "pytest-playwright"],
      "estructura_por_nivel": {
        "basico": "tests/{story_id}_test.py + data/{story_id}_data.json",
        "intermedio": "pages/{page_name}_page.py + tests/{story_id}_test.py + conftest.py + data/{story_id}_data.json",
        "avanzado": "pages/{page_name}_page.py + builders/{entity}_builder.py + tests/{story_id}_test.py + config/ + conftest.py + pytest.ini + data/{story_id}_data.json"
      }
    },
    {
      "id": "cypress",
      "framework_id": "cypress",
      "framework_name": "Cypress",
      "framework_type": "web-e2e",
      "nombre": "Cypress",
      "archivo": "automation-options/cypress.md",
      "rule_file": "ai/config/automation-options/cypress.md",
      "templates_path": "",
      "output_path": "ai/projects/{project_slug}/artifacts/{story_id}/test-automation/{version}/cypress",
      "lenguaje": "JavaScript",
      "tipo_app": ["web"],
      "ideal_para": ["frontend testing", "component testing", "rapid testing"],
      "estructura_carpetas": "ai/projects/{project_slug}/artifacts/{story_id}/test-automation/{version}/cypress/e2e/{story_id}.cy.js",
      "comando_ejecucion": "npx cypress run",
      "dependencias": ["cypress"],
      "estructura_por_nivel": {
        "basico": "cypress/e2e/{story_id}.cy.js + cypress/fixtures/{story_id}.json",
        "intermedio": "cypress/e2e/{story_id}.cy.js + cypress/pages/{PageName}.js + cypress/support/commands.js + cypress/fixtures/{story_id}.json",
        "avanzado": "cypress/e2e/{story_id}.cy.js + cypress/pages/{PageName}.js + cypress/support/commands.js + cypress.config.js + config/{environment}.json + cypress/fixtures/{story_id}.json"
      }
    },
    {
      "id": "pytest",
      "framework_id": "pytest",
      "framework_name": "Pytest API",
      "framework_type": "api",
      "nombre": "Pytest API",
      "archivo": "automation-options/pytest.md",
      "rule_file": "ai/config/automation-options/pytest.md",
      "templates_path": "",
      "output_path": "ai/projects/{project_slug}/artifacts/{story_id}/test-automation/{version}/pytest",
      "lenguaje": "Python",
      "tipo_app": ["api"],
      "ideal_para": ["apis rest", "microservicios", "contract testing", "backend testing"],
      "estructura_carpetas": "ai/projects/{project_slug}/artifacts/{story_id}/test-automation/{version}/pytest/tests/test_{story_id}.py",
      "comando_ejecucion": "pytest tests/ -v",
      "dependencias": ["pytest", "requests", "pytest-html"],
      "estructura_por_nivel": {
        "basico": "tests/test_{story_id}.py + data/{story_id}_data.json",
        "intermedio": "tests/test_{story_id}.py + helpers/api_client.py + conftest.py + data/{story_id}_data.json",
        "avanzado": "tests/test_{story_id}.py + helpers/api_client.py + builders/{entity}_builder.py + conftest.py + config/ + data/{story_id}_data.json"
      }
    }
  ]
}
